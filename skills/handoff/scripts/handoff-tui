#!/usr/bin/env python3
"""Launch the progress viewer from whichever copy of the skill is installed.

Plugin installs live under a version-pinned path, so a command line naming one
directly stops working at the next release. Copy this launcher somewhere on
PATH; it locates handoff_tui.py at run time and forwards every argument to it
unchanged.

Resolution order:
  1. $HANDOFF_TUI                     explicit path to handoff_tui.py
  2. a sibling handoff_tui.py         running in place inside a skill directory
  3. project and user skills          .agents/skills and .codex/skills
  4. installed_plugins.json           the registered plugin install, newest first
  5. the plugin cache and marketplace directories, if that registry is stale
  6. $HANDOFF_SKILL_REPO              a checkout of the source repository

A launcher copied onto PATH has no sibling, so it resolves dynamically and keeps
working across upgrades. One run in place inside a skill directory uses that
copy. --which prints the resolved path instead of running it; every other
argument belongs to handoff_tui.py.
"""

from __future__ import annotations

import glob
import json
import os
import subprocess
import sys
from pathlib import Path

SUFFIX = Path("skills") / "handoff" / "scripts" / "handoff_tui.py"
VIEWER = "handoff_tui.py"


def plugin_root() -> Path:
    config = os.environ.get("CLAUDE_CONFIG_DIR")
    base = Path(config).expanduser() if config else Path.home() / ".claude"
    return base / "plugins"


def rank(path: Path):
    """Order candidates by version directory, then by modification time."""
    version = []
    for part in path.parts:
        fields = part.split(".")
        if fields and all(field.isdigit() for field in fields):
            version = [int(field) for field in fields]
    try:
        modified = path.stat().st_mtime
    except OSError:
        modified = 0.0
    return (version, modified)


def newest(candidates) -> Path | None:
    found = [path for path in candidates if usable(path)]
    return max(found, key=rank) if found else None


def usable(path: Path) -> bool:
    # An older dashboard may exist alongside an updated install. It cannot
    # service Codex mode, even though ordinary snapshots still work there.
    return path.is_file() and ("--codex" not in sys.argv[1:]
                               or path.with_name("handoff_codex.py").is_file())


def from_registry(plugins: Path) -> Path | None:
    try:
        data = json.loads((plugins / "installed_plugins.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    installs = []
    for name, entries in (data.get("plugins") or {}).items():
        if name.split("@", 1)[0] != "handoff":
            continue
        for entry in entries or []:
            location = entry.get("installPath")
            if location:
                installs.append(Path(location).expanduser() / SUFFIX)
    return newest(installs)


def from_skills() -> Path | None:
    """Find project skills up to the repository root, then global Codex skills."""
    current = Path.cwd().resolve()
    for directory in (current, *current.parents):
        for host in (".agents", ".codex"):
            candidate = directory / host / "skills" / "handoff" / "scripts" / VIEWER
            if usable(candidate):
                return candidate
        if (directory / ".git").exists():
            break
    codex_home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
    for directory in (Path.home() / ".agents" / "skills", codex_home / "skills"):
        candidate = directory / "handoff" / "scripts" / VIEWER
        if usable(candidate):
            return candidate
    return None


def resolve() -> Path:
    override = os.environ.get("HANDOFF_TUI")
    if override:
        path = Path(override).expanduser()
        if not path.is_file():
            sys.exit("handoff-tui: $HANDOFF_TUI is not a file: %s" % path)
        if not usable(path):
            sys.exit("handoff-tui: $HANDOFF_TUI lacks Codex bar support; update that skill copy.")
        return path

    sibling = Path(__file__).resolve().with_name(VIEWER)
    if usable(sibling):
        return sibling

    found = from_skills()
    if found:
        return found

    plugins = plugin_root()
    found = from_registry(plugins)
    if found:
        return found

    for pattern in (
        plugins / "cache" / "*" / "handoff" / "*" / SUFFIX,
        plugins / "marketplaces" / "*" / SUFFIX,
    ):
        found = newest(Path(match) for match in glob.glob(str(pattern)))
        if found:
            return found

    checkout = os.environ.get("HANDOFF_SKILL_REPO")
    if checkout:
        path = Path(checkout).expanduser() / SUFFIX
        if usable(path):
            return path

    sys.exit(
        "handoff-tui: no %s found.\n"
        "Install or update the handoff skill/plugin, or set $HANDOFF_TUI to that script\n"
        "or $HANDOFF_SKILL_REPO to a checkout of the handoff-skill repository." % VIEWER
    )


def main() -> int:
    arguments = sys.argv[1:]
    viewer = resolve()
    if "--which" in arguments:
        print(viewer)
        return 0
    command = [sys.executable, str(viewer)] + arguments
    if os.name == "nt":
        # Windows has no exec that replaces the running process: os.execv
        # spawns and the launcher exits 0, so the viewer's status is lost and
        # every failure reads as success. Run it and forward the status.
        return subprocess.run(command).returncode
    os.execv(sys.executable, command)


if __name__ == "__main__":
    sys.exit(main())
